# address to listen on
PLAYPILE_ADDR=127.0.0.1:8080

# public URL of the instance. Steam OpenID needs this to be the address users
# actually reach, and the login callback is built from it.
PLAYPILE_BASE_URL=https://games.example.com

# where the SQLite database lives (created on first run)
PLAYPILE_DATA_DIR=/var/lib/playpile

# optional: Steam Web API key. Enables real display names + avatars at login
# and the "import my Steam library" button (the profile must be public).
# https://steamcommunity.com/dev/apikey
PLAYPILE_STEAM_API_KEY=

# default store region for prices, as an ISO country code (US, PL, DE, ...)
PLAYPILE_DEFAULT_COUNTRY=US

# language for store metadata
PLAYPILE_DEFAULT_LANGUAGE=english

# allows passwordless local test logins. never enable in production.
PLAYPILE_DEV_LOGIN=0
